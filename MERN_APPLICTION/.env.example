# ============================================================
# NodeScope - MERN File System & URL Explorer
# Root environment example. Copy to matching files:
#   backend/.env          -> backend server settings (below)
#   frontend/.env         -> frontend settings
# ============================================================

# ---- Backend (.env at backend/) ----
# MongoDB connection string (the "M" in MERN)
MONGODB_URI=mongodb://localhost:27017/nodescope

# Port for the Express server
PORT=5000

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173

# ---- Frontend (.env at frontend/) ----
# The React app uses VITE_API_URL for all API calls
VITE_API_URL=http://localhost:5000/api