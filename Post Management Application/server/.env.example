# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB (the Docker container `nodescope-mongo` is already published here).
# If auth is enabled on your local instance, use:
#   mongodb://<user>:<password>@127.0.0.1:27017/?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017

# Database and collection names used by the app.
MONGODB_DB=pma_blog
POSTS_COLLECTION=posts

# ---- CORS ----
# Comma-separated list of allowed browser origins, or * for any origin.
CORS_ORIGIN=*

# ---- Frontend ----
# Used only in production to serve the built React app from ../app/dist
SERVE_CLIENT=true
